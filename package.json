{
  "name": "@itslil/unified",
  "version": "11.0.6",
  "description": "unified processor reimplemented in LilScript",
  "keywords": [
    "unified",
    "processor",
    "plugin",
    "ast",
    "lilscript",
    "itslil"
  ],
  "homepage": "https://yeargun.github.io/unifiedlil/",
  "bugs": "https://github.com/yeargun/unifiedlil/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/unifiedlil.git"
  },
  "license": "MIT",
  "author": "yeargun",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/unified.cjs",
  "module": "./dist/unified.esm.js",
  "types": "./dist/unified.d.ts",
  "unpkg": "./dist/unified.umd.js",
  "jsdelivr": "./dist/unified.umd.js",
  "exports": {
    ".": {
      "types": "./dist/unified.d.ts",
      "import": "./dist/unified.esm.js",
      "require": "./dist/unified.cjs",
      "default": "./dist/unified.esm.js"
    },
    "./vfile": {
      "types": "./types/vfile.d.ts",
      "import": "./dist/vfile.esm.js",
      "require": "./dist/vfile.cjs",
      "default": "./dist/vfile.esm.js"
    },
    "./closed": "./dist/unified.closed.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist/unified.esm.js",
    "dist/unified.cjs",
    "dist/unified.umd.js",
    "dist/unified.closed.js",
    "dist/unified.d.ts",
    "dist/vfile.esm.js",
    "dist/vfile.cjs",
    "types/vfile.d.ts",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs --compile",
    "build:site": "node scripts/build-site.mjs",
    "test": "npm run check:sources && node --test test/*.test.mjs test/official/index.js && npm run check:types",
    "check:sources": "node scripts/check-shared-sources.mjs",
    "check:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext test/types.test.ts",
    "check:site": "npm run build:site && node --test test/site.test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "measure:graph": "node scripts/measure-graph.mjs",
    "record:release": "node scripts/record-release.mjs",
    "prepublishOnly": "npm test && npm run check:pack && npm run check:site"
  },
  "dependencies": {
    "unified": "^11.0.0",
    "vfile": "^6.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "terser": "5.51.2",
    "typescript": "^5.9.2"
  }
}
